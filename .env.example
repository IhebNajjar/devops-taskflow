# TaskFlow Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Application Port
PORT=8000

# Database Connection URL (Set for PostgreSQL; leave blank for SQLite local mode)
# In Docker Compose, the database service is named 'db'
DATABASE_URL=postgresql://taskflow_user:taskflow_pass@db:5432/taskflow_db

# Optional AI API Key (Groq 120B)
GROQ_API_KEY=

# Image Tag for Deployment & Rollback
IMAGE_TAG=v1.0.0
